{
  "GOALDRIVE": {
    "event": "UserPromptSubmit",
    "matcher": "",
    "status": "enabled",
    "settingsFile": ".claude/settings.local.json",
    "hookEntry": {
      "type": "command",
      "command": ".claude/hooks/handlers/goaldrive.sh"
    }
  },
  "VERIFYFLAG": {
    "event": "UserPromptSubmit",
    "matcher": "",
    "status": "enabled",
    "settingsFile": ".claude/settings.local.json",
    "hookEntry": {
      "type": "command",
      "command": ".claude/hooks/handlers/verifyflag.sh"
    }
  },
  "VERIFYGATE": {
    "event": "Stop",
    "matcher": "",
    "status": "enabled",
    "settingsFile": ".claude/settings.local.json",
    "hookEntry": {
      "type": "command",
      "command": ".claude/hooks/handlers/verifygate.sh"
    }
  },
  "BEEP": {
    "event": "Stop",
    "matcher": "",
    "status": "enabled",
    "settingsFile": ".claude/settings.local.json",
    "hookEntry": {
      "type": "command",
      "command": "afplay /System/Library/Sounds/Glass.aiff"
    }
  },
  "FINALGATE": {
    "event": "UserPromptSubmit",
    "matcher": "",
    "status": "disabled",
    "settingsFile": "~/.claude/settings.json",
    "hookEntry": {
      "type": "command",
      "command": "echo '[Final Gate] Complete / Sourced / Labeled on every reply; add Attacked / Risk-weighted / Deliverable when the answer is costly to redo or hard to reverse.'"
    }
  }
}
